OPENROUTER_API_KEY=your-openrouter-api-key-here

# ─── Mode Koneksi ──────────────────────────────────────────────────────────────
# local     = hanya SQLite FTS5 lokal, tidak perlu backend
# share     = gunakan shared backend (butuh SERVER_URL)
# self-host = backend Python sendiri (butuh SERVER_URL + SERVER_API_KEY)
NANOCLI_MODE=local

# ─── Backend Python (opsional, hanya jika mode=share atau self-host) ──────────
SERVER_URL=http://localhost:8000
SERVER_API_KEY=change-me-before-deploying

# ─── Default Model per Mode ───────────────────────────────────────────────────
# fast        = cepat dan murah
# normal      = seimbang (default)
# high        = kualitas tinggi
# extra-high  = terbaik, paling mahal
MODEL_FAST=google/gemini-flash-1.5
MODEL_NORMAL=anthropic/claude-3.5-sonnet
MODEL_HIGH=anthropic/claude-3.5-sonnet
MODEL_EXTRA_HIGH=anthropic/claude-3-opus

# ─── Catatan Keamanan ─────────────────────────────────────────────────────────
# Jangan commit file .env ke repository!
# File ini hanya sebagai contoh (example).
# Salin ke .env dan isi dengan nilai yang benar.
# Tambahkan .env ke .gitignore.
