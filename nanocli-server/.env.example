# ─── NanoCLI Server — Environment Variables ──────────────────────────────────
# Copy file ini ke .env dan isi semua variabel sebelum docker compose up.

# ─── WAJIB: API Key Autentikasi ───────────────────────────────────────────────
# Server TIDAK AKAN START tanpa ini (kecuali NANOCLI_DEV_MODE=true).
# Generate dengan: openssl rand -hex 32
API_KEY=ganti_dengan_api_key_kuat_di_sini

# Mode development — set true HANYA untuk dev lokal, JANGAN di production
NANOCLI_DEV_MODE=false

# ─── Database PostgreSQL ──────────────────────────────────────────────────────
DB_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=nanocli
POSTGRES_USER=nanocli

# ─── Server Config ────────────────────────────────────────────────────────────
# Port yang di-expose untuk nanocli-api (default: 8080)
API_PORT=8080

# Feature flag: set false untuk deployment ringan (hanya /health dan /telemetry/*)
ENABLE_RAG=true

# ─── Ollama Embedding ─────────────────────────────────────────────────────────
# Model embedding (hanya dipakai jika ENABLE_RAG=true)
# nomic-embed-text  = ringan 274MB (direkomendasikan)
# mxbai-embed-large = lebih akurat tapi 669MB
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
