# ─── NanoCLI Server — Environment Variables ──────────────────────────────────
# Copy file ini ke .env dan isi semua variabel sebelum docker compose up.

# Password database PostgreSQL (WAJIB)
DB_PASSWORD=ganti_dengan_password_kuat

# API Key untuk autentikasi NanoCLI ke home server (WAJIB untuk self-host)
# Generate: openssl rand -hex 32
NANOCLI_API_KEY=ganti_dengan_api_key_kuat

# Database config (Share mode override)
POSTGRES_DB=nanocli
POSTGRES_USER=nanocli

# Port yang di-expose untuk nanocli-api (default: 8080)
API_PORT=8080

# Model embedding Ollama (default: nomic-embed-text, ringan 274MB)
# Hanya dipakai di self-host mode (ENABLE_RAG=true)
# Alternatif: mxbai-embed-large (akurat tapi 669MB)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Log level (debug|info|warning|error)
LOG_LEVEL=info
